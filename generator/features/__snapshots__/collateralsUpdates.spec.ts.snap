// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`feature: collateralsUpdates > should return reasonable code 1`] = `
{
  "code": {
    "fn": [
      "function collateralsUpdates() public pure override returns (IAaveV3ConfigEngine.CollateralUpdate[] memory) {
          IAaveV3ConfigEngine.CollateralUpdate[] memory collateralUpdate = new IAaveV3ConfigEngine.CollateralUpdate[](2);

          collateralUpdate[0] = IAaveV3ConfigEngine.CollateralUpdate({
               asset: AaveV3EthereumAssets.DAI_UNDERLYING,
               ltv: 0,
               liqThreshold: EngineFlags.KEEP_CURRENT,
               liqBonus: EngineFlags.KEEP_CURRENT,
               liqProtocolFee: EngineFlags.KEEP_CURRENT
             });
collateralUpdate[1] = IAaveV3ConfigEngine.CollateralUpdate({
               asset: AaveV3EthereumAssets.USDC_UNDERLYING,
               ltv: 77_00,
               liqThreshold: 80_00,
               liqBonus: 5_00,
               liqProtocolFee: 10_00
             });

          return collateralUpdate;
        }",
    ],
  },
  "test": {
    "fn": [
      "function test_collateralUpdatesConfiguration() public {
      ReserveConfig[] memory allConfigsBefore = _getReservesConfigs(AaveV3Ethereum.POOL);
      GovV3Helpers.executePayload(vm,address(proposal));
      ReserveConfig[] memory allConfigsAfter = _getReservesConfigs(AaveV3Ethereum.POOL);

      ReserveConfig memory expected_DAI = _findReserveConfig(allConfigsBefore, AaveV3EthereumAssets.DAI_UNDERLYING);
      expected_DAI.ltv = 0;
      expected_DAI.usageAsCollateralEnabled = expected_DAI.liquidationThreshold != 0;
      _validateReserveConfig(expected_DAI, allConfigsAfter);

ReserveConfig memory expected_USDC = _findReserveConfig(allConfigsBefore, AaveV3EthereumAssets.USDC_UNDERLYING);
      expected_USDC.ltv = 77_00;
expected_USDC.liquidationThreshold = 80_00;
expected_USDC.liquidationBonus = 100_00 + 5_00;
expected_USDC.liquidationProtocolFee = 10_00;
      expected_USDC.usageAsCollateralEnabled = expected_USDC.liquidationThreshold != 0;
      _validateReserveConfig(expected_USDC, allConfigsAfter);
    }",
    ],
  },
}
`;
